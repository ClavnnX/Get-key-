{
  "version": 2,
  "functions": {
    "index.js": {
      "runtime": "@vercel/node@18.x"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/index.js"
    },
    {
      "src": "/step1",
      "dest": "/index.js"
    },
    {
      "src": "/step2", 
      "dest": "/index.js"
    },
    {
      "src": "/step3",
      "dest": "/index.js"
    },
    {
      "src": "/generate",
      "dest": "/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}

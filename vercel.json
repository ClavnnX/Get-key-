{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@18.x"
    }
  },
  "routes": [
    {
      "src": "/generate",
      "dest": "/api/generate"
    },
    {
      "src": "/verify",
      "dest": "/api/verify"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ],
  "env": {
    "SUPABASE_URL": "https://vrjtcfvjqwzenvsdeixd.supabase.co",
    "SUPABASE_ANON_KEY": "@supabase-anon-key"
  }
}

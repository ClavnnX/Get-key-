{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.js"
    },
    {
      "src": "/step1",
      "dest": "/index.js"
    },
    {
      "src": "/step2", 
      "dest": "/index.js"
    },
    {
      "src": "/step3",
      "dest": "/index.js"
    },
    {
      "src": "/generate",
      "dest": "/index.js"
    },
    {
      "src": "/start-verification",
      "dest": "/index.js"
    },
    {
      "src": "/getkey",
      "dest": "/index.js"
    },
    {
      "src": "/validate",
      "dest": "/index.js"
    },
    {
      "src": "/verify",
      "dest": "/index.js"
    },
    {
      "src": "/callback/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/status",
      "dest": "/index.js"
    },
    {
      "src": "/stats",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
